---
const hubs = [
  {
    "title": "13 dobrych praktyk innowacji w miejscu pracy",
    "titleEn": "13 best practices for workplace innovation",
    "url": "https://innowacje.covepolska.pl/",
    "image": "assets/Logo-2025.png",
    "alt": "Logo projektu WIN4SMEs",
    "altEn": "WIN4SMEs project logo",
    "eyebrow": "Rozwiązania dla firm",
    "eyebrowEn": "Solutions for companies",
    "lead": "Katalog europejskich rozwiązań wspierających innowacje w małych i średnich przedsiębiorstwach. Poznaj 13 wybranych praktyk oraz metodologię ich wyboru w ramach WP3 projektu WIN4SMEs.",
    "leadEn": "A catalogue of European approaches to innovation in small and medium-sized enterprises. Explore 13 selected practices and the selection methodology developed under WIN4SMEs WP3."
  },
  {
    "title": "Kompas BiZ — Biznes i Zarządzanie",
    "titleEn": "Kompas BiZ — Business and Management",
    "url": "https://taniroda.covepolska.pl/",
    "image": "assets/Logo-2025.png",
    "alt": "Logo projektu WIN4SMEs",
    "altEn": "WIN4SMEs project logo",
    "eyebrow": "Przedsiębiorczość w praktyce",
    "eyebrowEn": "Entrepreneurship in practice",
    "lead": "Pakiet dla nauczycieli oparty na modelu firmy ćwiczebnej Taniroda: 14 modułów i 90 materiałów, w tym scenariusze lekcji, prezentacje, karty pracy i klucze odpowiedzi. Pomaga rozwijać kompetencje przedsiębiorcze, finansowe i organizacyjne.",
    "leadEn": "A teaching package based on the Taniroda practice enterprise model: 14 modules and 90 resources, including lesson plans, presentations, worksheets and answer keys. Supports entrepreneurial, financial and organisational skills."
  },
  {
    "title": "Mapa szkolnictwa sektorowego we Wrocławiu",
    "titleEn": "Map of vocational education in Wrocław",
    "url": "https://mapa.covepolska.pl/",
    "image": "assets/offer-logos/mapa.png",
    "alt": "Logo: Mapa szkolnictwa sektorowego we Wrocławiu",
    "altEn": "Logo: Map of vocational education in Wrocław",
    "eyebrow": "Wybór ścieżki edukacyjnej",
    "eyebrowEn": "Educational pathways",
    "lead": "Wyszukiwarka szkół i profili kształcenia według branży, zawodu i ścieżki edukacyjnej. Ułatwia porównanie techników, szkół branżowych, kwalifikacyjnych kursów zawodowych i oferty centrów umiejętności.",
    "leadEn": "Find schools and programmes by sector, occupation and educational pathway. Compare technical secondary schools, vocational schools, vocational qualification courses and skills centre provision."
  },
  {
    "title": "MentorStart — wdrożenie nauczycieli",
    "titleEn": "MentorStart — teacher induction",
    "url": "https://mentor.covepolska.pl/",
    "image": "assets/offer-logos/mentor.png",
    "alt": "Logo: MentorStart — wdrożenie nauczycieli",
    "altEn": "Logo: MentorStart — teacher induction",
    "eyebrow": "Rozwój nauczycieli",
    "eyebrowEn": "Teacher development",
    "lead": "Praktyczne ścieżki dla mentorów, początkujących nauczycieli i dyrekcji na pierwszy rok pracy. Zawiera model rozmów 6+3, wskazówki do obserwacji lekcji, listy kontrolne i formularze do wykorzystania w szkole.",
    "leadEn": "Practical first-year pathways for mentors, beginning teachers and school leaders. Includes a 6+3 conversation model, lesson observation guidance, checklists and forms for use in schools."
  },
  {
    "title": "Portal współpracy dla szkolnictwa zawodowego",
    "titleEn": "Vocational education collaboration portal",
    "url": "https://portal.covepolska.pl/",
    "image": "assets/offer-logos/portal.png",
    "alt": "Logo: Portal współpracy dla szkolnictwa zawodowego",
    "altEn": "Logo: Vocational education collaboration portal",
    "eyebrow": "Współpraca szkół",
    "eyebrowEn": "School collaboration",
    "lead": "Prezentacja portalu dla szkół, koordynatorów praktyk i instytucji partnerskich. Pokazuje bibliotekę materiałów, bazę dobrych praktyk, forum i narzędzia organizacyjne; zamknięta część z kontami użytkowników jest planowana do wdrożenia.",
    "leadEn": "An overview of a portal for schools, placement coordinators and partner institutions. Presents a resource library, a best practice database, a forum and organisational tools; the restricted area with user accounts is planned for deployment."
  },
  {
    "title": "AI w edukacji, organizacji i projektach",
    "titleEn": "AI in education, organisations and projects",
    "url": "https://ai.covepolska.pl/",
    "image": "assets/Logo-2025.png",
    "alt": "Logo projektu WIN4SMEs",
    "altEn": "WIN4SMEs project logo",
    "eyebrow": "Sztuczna inteligencja",
    "eyebrowEn": "Artificial intelligence",
    "lead": "Samodzielny kurs online dla nauczycieli: od podstaw AI i tworzenia promptów po dydaktykę, analitykę i pracę projektową. Sześć modułów uzupełniają ćwiczenia, gotowe prompty, checklisty, prezentacje i plan wdrożenia.",
    "leadEn": "A self-paced online course for teachers covering AI fundamentals, prompting, teaching, analytics and project work. Six modules are complemented by exercises, ready-to-use prompts, checklists, presentations and an implementation plan."
  },
  {
    "title": "Trening umiejętności życiowych",
    "titleEn": "Life skills training",
    "url": "https://tuz.covepolska.pl/",
    "image": "assets/offer-logos/tuz.png",
    "alt": "Logo: Trening umiejętności życiowych",
    "altEn": "Logo: Life skills training",
    "eyebrow": "Kompetencje osobiste",
    "eyebrowEn": "Personal skills",
    "lead": "Program sześciu warsztatów dla młodzieży, także osób z trudnościami w uczeniu się i funkcjonowaniu społecznym. Rozwija samodzielność, komunikację, stawianie granic, współpracę oraz radzenie sobie z emocjami i konfliktami.",
    "leadEn": "A six-module workshop programme for young people, including those with learning and social difficulties. Develops independence, communication, boundary setting, teamwork and skills for managing emotions and conflict."
  },
  {
    "title": "Uruchom zaangażowanie — uczeń, który nie chce się uczyć",
    "titleEn": "Build engagement — supporting reluctant learners",
    "url": "https://zaangazowanie.covepolska.pl/",
    "image": "assets/offer-logos/zaangazowanie.png",
    "alt": "Logo: Uruchom zaangażowanie — uczeń, który nie chce się uczyć",
    "altEn": "Logo: Build engagement — supporting reluctant learners",
    "eyebrow": "Motywacja uczniów",
    "eyebrowEn": "Student motivation",
    "lead": "Kurs dla nauczycieli szkół branżowych i techników o motywacji, poczuciu skuteczności i relacjach z uczniami. Oferuje mikrocele, metody aktywizujące oraz bank praktyk do wypróbowania na najbliższej lekcji.",
    "leadEn": "A course for vocational and technical secondary school teachers on motivation, self-efficacy and relationships with students. Offers small-step goals, active learning methods and a bank of practices to try in the next lesson."
  }
];

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nasza oferta – COVE Polska</title>
    <meta
      name="description"
      content="Poznaj osiem serwisów COVE Polska i WIN4SMEs: kursy dla nauczycieli, materiały do zajęć, dobre praktyki dla firm, mapę szkolnictwa zawodowego i portal współpracy szkół."
    />
    <meta property="og:title" content="Nasza oferta – COVE Polska" />
    <meta
      property="og:description"
      content="Poznaj praktyczne zasoby przygotowane w ramach działań COVE Polska i WIN4SMEs."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://covepolska.pl/nasze-dzialania/" />
    <meta property="og:image" content="https://covepolska.pl/assets/cove-polska-logo.png" />
    <meta name="theme-color" content="#0d2b66" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href={`${base}hub.css`} />
  </head>
  <body>
    <header class="site-header" role="banner">
      <div class="header-inner">
        <div class="logo-strip">
          <a href="https://win4smes.eu" target="_blank" rel="noopener noreferrer" aria-label="WIN4SMEs website">
            <img src={`${base}assets/Logo-2025.png`} alt="WIN4SMEs" />
          </a>
          <div class="logo-divider"></div>
          <a href={base} aria-label="COVE Polska – strona główna">
            <img src={`${base}assets/cove-polska-logo.png`} alt="COVE Polska" />
          </a>
          <div class="logo-divider"></div>
          <a href="https://ec.europa.eu/info/funding-tenders/opportunities/portal/screen/home" target="_blank" rel="noopener noreferrer" aria-label="EU Funding portal">
            <img src={`${base}assets/PL_Co-fundedbytheEU_RGB_POS.png`} alt="Dofinansowane przez Unię Europejską" id="eu-logo-header" />
          </a>
        </div>

        <nav class="header-nav" aria-label="Main navigation">
          <a href={`${base}#about`} data-i18n="nav_about">O projekcie</a>
          <a href={`${base}#partners`} data-i18n="nav_partners">Partnerzy</a>
          <a href={`${base}aktualnosci/`} data-i18n="nav_news">Aktualności</a>
          <a href={`${base}nasze-dzialania/`} class="active" data-i18n="nav_offer">Nasza oferta</a>
          <a href={`${base}kontakt/`} data-i18n="nav_contact">Kontakt</a>
        </nav>

        <button class="hamburger" id="hamburger-btn" aria-label="Menu" aria-expanded="false">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>

        <div class="lang-switch" role="group" aria-label="Language selection">
          <button class="lang-btn" id="btn-en" type="button" aria-pressed="false">EN</button>
          <button class="lang-btn active" id="btn-pl" type="button" aria-pressed="true">PL</button>
        </div>
      </div>
    </header>

    <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation">
      <a href={`${base}#about`} data-i18n="nav_about">O projekcie</a>
      <a href={`${base}#partners`} data-i18n="nav_partners">Partnerzy</a>
      <a href={`${base}aktualnosci/`} data-i18n="nav_news">Aktualności</a>
      <a href={`${base}nasze-dzialania/`} class="active" data-i18n="nav_offer">Nasza oferta</a>
      <a href={`${base}kontakt/`} data-i18n="nav_contact">Kontakt</a>
    </nav>

    <main>
      <section class="hero" aria-labelledby="main-heading">
        <div class="container hero-inner">
          <p class="section-kicker" data-i18n="offer_kicker">Nasza oferta</p>
          <h1 id="main-heading" data-i18n="offer_h1">COVE Polska – przestrzeń wiedzy, innowacji i rozwoju</h1>
          <p class="hero-lead" data-i18n="offer_lead">Poznaj osiem serwisów COVE Polska i WIN4SMEs: kursy dla nauczycieli, materiały do zajęć, dobre praktyki dla firm, mapę szkolnictwa zawodowego i portal współpracy szkół.</p>
        </div>
      </section>

      <section class="hub-section" aria-label="Podstrony COVE Polska">
        <div class="container hub-grid">
          {
            hubs.map((hub) => (
              <article class="hub-card">
                {hub.image && <a class="hub-media-link hub-logo-link" href={hub.url} aria-label={`Przejdź do strony: ${hub.title}`} data-aria-pl={`Przejdź do strony: ${hub.title}`} data-aria-en={`Visit website: ${hub.titleEn}`}>
                  <img class="hub-image hub-logo" src={`${base}${hub.image}`} alt={hub.alt} data-alt-pl={hub.alt} data-alt-en={hub.altEn} loading="lazy" />
                </a>}
                <div class="hub-content">
                  <p class="hub-eyebrow" data-pl={hub.eyebrow} data-en={hub.eyebrowEn}>{hub.eyebrow}</p>
                  <h2 data-pl={hub.title} data-en={hub.titleEn}>{hub.title}</h2>
                  <p data-pl={hub.lead} data-en={hub.leadEn}>{hub.lead}</p>
                  <a class="button" href={hub.url}>
                    <span data-i18n="button_visit">Przejdź do strony</span>
                    <span aria-hidden="true">→</span>
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-logos" aria-label="Logotypy projektu i finansowania">
          <img src={`${base}assets/Logo-2025.png`} alt="WIN4SMEs" />
          <img id="eu-logo-footer" src={`${base}assets/PL_Co-fundedbytheEU_RGB_POS.png`} alt="Współfinansowane przez Unię Europejską" />
          <a href="https://www.wroclaw.pl/" target="_blank" rel="noopener noreferrer" aria-label="Wrocław website">
            <img class="wroclaw-logo" id="wroclaw-logo-footer" src={`${base}assets/wroclaw-miasto-spotkan.png`} alt="Wrocław Miasto Spotkań" />
          </a>
        </div>
        <p data-i18n="footer_note">
          Współfinansowane przez Unię Europejską. Wyrażone poglądy i opinie są wyłącznie poglądami autorów i niekoniecznie odzwierciedlają stanowisko Unii Europejskiej lub Europejskiej Agencji Wykonawczej ds. Edukacji i Kultury (EACEA).
        </p>
        <nav class="footer-links" aria-label="Footer links">
          <a href={`${base}deklaracja-dostepnosci/`} data-i18n="footer_accessibility">Deklaracja dostępności</a>
        </nav>
      </div>
    </footer>

    <script define:vars={{ base }}>
      const I18N = {
        pl: {
          nav_about: "O projekcie",
          nav_partners: "Partnerzy",
          nav_news: "Aktualności",
          nav_offer: "Nasza oferta",
          nav_contact: "Kontakt",
          offer_kicker: "Nasza oferta",
          offer_h1: "COVE Polska – przestrzeń wiedzy, innowacji i rozwoju",
          offer_lead: "Poznaj osiem serwisów COVE Polska i WIN4SMEs: kursy dla nauczycieli, materiały do zajęć, dobre praktyki dla firm, mapę szkolnictwa zawodowego i portal współpracy szkół.",
          button_visit: "Przejdź do strony",
          footer_note: "Współfinansowane przez Unię Europejską. Wyrażone poglądy i opinie są wyłącznie poglądami autorów i niekoniecznie odzwierciedlają stanowisko Unii Europejskiej lub Europejskiej Agencji Wykonawczej ds. Edukacji i Kultury (EACEA).",
          footer_accessibility: "Deklaracja dostępności"
        },
        en: {
          nav_about: "About project",
          nav_partners: "Partners",
          nav_news: "News",
          nav_offer: "Our offer",
          nav_contact: "Contact",
          offer_kicker: "Our offer",
          offer_h1: "COVE Polska – knowledge, innovation and development",
          offer_lead: "Explore eight COVE Polska and WIN4SMEs websites: teacher training courses, classroom resources, best practices for businesses, a vocational education map and a school collaboration portal.",
          button_visit: "Visit website",
          footer_note: "Co-funded by the European Union. Views and opinions expressed are those of the authors only and do not necessarily reflect those of the European Union or EACEA.",
          footer_accessibility: "Accessibility statement"
        }
      };

      const LANG_STORAGE_KEY = "covePolskaLang";

      function getSavedLang() {
        try {
          const stored = localStorage.getItem(LANG_STORAGE_KEY);
          return stored === "en" || stored === "pl" ? stored : "pl";
        } catch (error) {
          return "pl";
        }
      }

      function setLang(lang, persist = true) {
        document.documentElement.setAttribute("lang", lang);
        document.querySelectorAll("[data-i18n]").forEach((el) => {
          const key = el.dataset.i18n;
          if (I18N[lang][key]) el.textContent = I18N[lang][key];
        });
        document.querySelectorAll("[data-pl][data-en]").forEach((el) => {
          el.textContent = el.dataset[lang];
        });
        document.querySelectorAll("[data-aria-pl][data-aria-en]").forEach((el) => {
          el.setAttribute("aria-label", lang === "pl" ? el.dataset.ariaPl : el.dataset.ariaEn);
        });
        document.querySelectorAll("[data-alt-pl][data-alt-en]").forEach((img) => {
          img.alt = lang === "pl" ? img.dataset.altPl : img.dataset.altEn;
        });
        document.getElementById("btn-pl").classList.toggle("active", lang === "pl");
        document.getElementById("btn-en").classList.toggle("active", lang === "en");
        document.getElementById("btn-pl").setAttribute("aria-pressed", lang === "pl");
        document.getElementById("btn-en").setAttribute("aria-pressed", lang === "en");
        const wroclaw = document.getElementById("wroclaw-logo-footer");
        if (wroclaw) {
          wroclaw.src = lang === "pl" ? `${base}assets/wroclaw-miasto-spotkan.png` : `${base}assets/wroclaw-meeting-place-better.png`;
          wroclaw.alt = lang === "pl" ? "Wrocław Miasto Spotkań" : "Wrocław the Meeting Place";
        }
        const euHeader = document.getElementById("eu-logo-header");
        const euFooter = document.getElementById("eu-logo-footer");
        const euSrc = lang === "pl" ? `${base}assets/PL_Co-fundedbytheEU_RGB_POS.png` : `${base}assets/EN_Co-fundedbytheEU_RGB_POS.png`;
        if (euHeader) {
          euHeader.src = euSrc;
          euHeader.alt = lang === "pl" ? "Dofinansowane przez Unię Europejską" : "Co-funded by the European Union";
        }
        if (euFooter) {
          euFooter.src = euSrc;
          euFooter.alt = lang === "pl" ? "Współfinansowane przez Unię Europejską" : "Co-funded by the European Union";
        }
        if (persist) {
          try {
            localStorage.setItem(LANG_STORAGE_KEY, lang);
          } catch (error) {}
        }
      }

      document.getElementById("btn-pl").addEventListener("click", () => setLang("pl"));
      document.getElementById("btn-en").addEventListener("click", () => setLang("en"));
      setLang(getSavedLang(), false);
      document.getElementById("hamburger-btn").addEventListener("click", () => {
        const nav = document.getElementById("mobile-nav");
        const isOpen = nav.classList.toggle("open");
        document.getElementById("hamburger-btn").setAttribute("aria-expanded", isOpen);
      });
    </script>
  </body>
</html>
